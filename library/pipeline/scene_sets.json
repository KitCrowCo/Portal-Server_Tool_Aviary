{
 "name": "Scene sets: many scenes at once",
 "group": "simulation",
 "objective": "The same two characters and DM played through many openings at the same time (one scene per opening), as far as the machines allow: bind a role to a resource pool and its scenes spread over every machine in it. Gives every transcript.",
 "roles": {
  "a": {
   "needs": [
    "chat"
   ],
   "about": "the first character's model (a pool spreads the scenes)"
  },
  "b": {
   "needs": [
    "chat"
   ],
   "about": "the second character's model"
  },
  "dm": {
   "needs": [
    "chat"
   ],
   "about": "the game master's model"
  }
 },
 "keep": true,
 "params": {
  "openings": {
   "label": "Openings, one scene each",
   "type": "long",
   "default": "",
   "hint": "A blank line between openings."
  },
  "a_name": {
   "label": "First character's name",
   "default": "Ari"
  },
  "a_brief": {
   "label": "Who the first character is",
   "type": "long",
   "default": ""
  },
  "b_name": {
   "label": "Second character's name",
   "default": "Bram"
  },
  "b_brief": {
   "label": "Who the second character is",
   "type": "long",
   "default": ""
  },
  "dm_brief": {
   "label": "The DM's brief",
   "type": "long",
   "default": "You are the game master of this scene. Keep it moving toward a turning point, keep the characters true to themselves and to the world, and end it (DONE) once it has reached one."
  },
  "rounds": {
   "label": "Most rounds per scene",
   "type": "integer",
   "default": 8
  }
 },
 "steps": [
  {
   "id": "split",
   "type": "expr",
   "needs": [
    "openings"
   ],
   "gives": [
    "scenes"
   ],
   "config": {
    "expr": "[x.strip() for x in str(openings or '').split('\\n\\n') if x.strip()]",
    "give": "scenes"
   }
  },
  {
   "id": "play",
   "type": "pipeline",
   "needs": [
    "scenes",
    "a_name",
    "a_brief",
    "b_name",
    "b_brief",
    "dm_brief",
    "rounds"
   ],
   "gives": [
    "transcripts",
    "endings"
   ],
   "keep": true,
   "config": {
    "pipeline": "scene_dm",
    "each": "scenes",
    "failed": "left_out",
    "roles": {
     "a": "a",
     "b": "b",
     "dm": "dm"
    },
    "inputs": {
     "opening": "{item}",
     "a_name": "{a_name}",
     "a_brief": "{a_brief}",
     "b_name": "{b_name}",
     "b_brief": "{b_brief}",
     "dm_brief": "{dm_brief}",
     "rounds": "{rounds}"
    },
    "give": {
     "transcripts": "transcript",
     "endings": "ended"
    }
   }
  }
 ]
}
